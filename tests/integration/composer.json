{
  "require": {
    "behat/behat": "3.32.0",
    "guzzlehttp/guzzle": "7.15.3",
    "jarnaiz/behat-junit-formatter": "1.3.2",
    "libresign/nextcloud-behat": "1.6.0",
    "php-http/guzzle7-adapter": "1.1.0",
    "php-http/message": "1.16.2"
  },
  "scripts": {
    "behat": "@php -d error_reporting=24575 vendor/bin/behat -f junit -f pretty --colors"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.3"
    }
  }
}
