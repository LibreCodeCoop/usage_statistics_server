{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.2/resources/schema.json",
    "source": {
        "directories": [
            "lib"
        ],
        "excludes": [
            "AppInfo",
            "Migration"
        ]
    },
    "bootstrap": "tests/php/bootstrap.php",
    "phpUnit": {
        "configDir": "tests/php"
    },
    "minMsi": 0,
    "minCoveredMsi": 0,
    "mutators": {
        "@default": true
    }
}
