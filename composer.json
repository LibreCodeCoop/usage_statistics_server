{
    "name": "vitormattos/usage-statistics-server",
    "description": "Nextcloud app for receiving and aggregating privacy-preserving usage statistics.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-master",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "OCA\\UsageStatisticsServer\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCP\\": "vendor/nextcloud/ocp/OCP",
            "OCA\\UsageStatisticsServer\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "find lib tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test:unit": "phpunit -c tests/php/phpunit.xml --no-coverage --colors=always --fail-on-warning --fail-on-risky"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    }
}
